<Core:StyleSheet id="6d767e1f-1f09-4cad-8411-dfca53688480">
<styleSheet>
<val>diagram {
}

state[name="M1 — Entendendo o problema  [Bloom: Lembrar + Compreender]"] {
  background-color: rgba(255, 255, 255, 1.0);
  text-color: rgba(0, 0, 0, 1.0);
}

state[name="CustoQuery : conceito : slides — Explanatório: custo de query, ciclo da consulta; métricas: Tempo, I/O, CPU, Memória"] {
  background-color: rgba(255, 192, 203, 1.0);
  text-color: rgba(0, 0, 0, 1.0);
}

state[name="QueryLenta : exemplo : video — Exemplo: demonstração de query lenta no PostgreSQL real"] {
  background-color: rgba(255, 192, 203, 1.0);
  text-color: rgba(0, 0, 0, 1.0);
}

state[name="AD_M1 : avaliacao_diagnostica : quiz — Avaliação diagnóstica: quiz com 3 questões sobre conhecimento prévio"] {
  background-color: rgba(224, 62, 62, 1.0);
  text-color: rgba(255, 255, 255, 1.0);
}

state[name="Finalidade: Sensibilizar sobre o custo de queries e a importância da otimização"] {
  background-color: rgba(214, 42, 214, 1.0);
  text-color: rgba(255, 255, 255, 1.0);
}

state[name="M2 — Diagnóstico  [Bloom: Compreender + Analisar]"] {
  background-color: rgba(255, 255, 255, 1.0);
  text-color: rgba(0, 0, 0, 1.0);
}

state[name="EXPLAIN : conceito : slides — Explanatório: EXPLAIN, EXPLAIN ANALYZE, BUFFERS, FORMAT JSON"] {
  background-color: rgba(132, 222, 239, 1.0);
  text-color: rgba(0, 0, 0, 1.0);
}

state[name="EXPLAIN_ANALYZE : procedimento : codigo_sql — Procedimento: executar e interpretar a saída do EXPLAIN ANALYZE"] {
  background-color: rgba(132, 222, 239, 1.0);
  text-color: rgba(0, 0, 0, 1.0);
}

state[name="PlanoExecucao : conceito : slides — Explanatório: plano de execução; Seq Scan, Index Scan, Index Only Scan, Bitmap Heap Scan"] {
  background-color: rgba(132, 222, 239, 1.0);
  text-color: rgba(0, 0, 0, 1.0);
}

state[name="EstrategiasJoin : conceito : slides — Explanatório: Nested Loop, Hash Join, Merge Join — condições de uso"] {
  background-color: rgba(132, 222, 239, 1.0);
  text-color: rgba(0, 0, 0, 1.0);
}

state[name="EstrategiasJoin : principio : slides — Princípio: quando o planejador escolhe cada estratégia de join"] {
  background-color: rgba(132, 222, 239, 1.0);
  text-color: rgba(0, 0, 0, 1.0);
}

state[name="pgStatStatements : conceito : slides — Explanatório: pg_stat_statements e pg_stat_activity"] {
  background-color: rgba(132, 222, 239, 1.0);
  text-color: rgba(0, 0, 0, 1.0);
}

state[name="DiagnosticarQuery : exercicio : hands_on — Exercício: diagnosticar query real com EXPLAIN"] {
  background-color: rgba(132, 222, 239, 1.0);
  text-color: rgba(0, 0, 0, 1.0);
}

state[name="AF_M2 : avaliacao_formativa : quiz — Avaliação formativa sobre diagnóstico e plano de execução"] {
  background-color: rgba(53, 102, 222, 1.0);
  text-color: rgba(255, 255, 255, 1.0);
}

state[name="Finalidade: Identificar gargalos de performance em queries"] {
  background-color: rgba(53, 102, 222, 1.0);
  text-color: rgba(255, 255, 255, 1.0);
}

state[name="M3A — Índices  [Bloom: Analisar]"] {
  background-color: rgba(255, 255, 255, 1.0);
  text-color: rgba(0, 0, 0, 1.0);
}

state[name="BTree_GIN_GIST_BRIN : conceito : slides — Explanatório: B-Tree (igualdade/intervalos), GIN (arrays/JSONB), GiST (espacial), BRIN (sequências longas)"] {
  background-color: rgba(134, 222, 134, 1.0);
  text-color: rgba(0, 0, 0, 1.0);
}

state[name="IndiceParcial_Composto : conceito : slides — Explanatório: índice parcial (WHERE), índice composto (múltiplas colunas)"] {
  background-color: rgba(134, 222, 134, 1.0);
  text-color: rgba(0, 0, 0, 1.0);
}

state[name="IndexOnlyScan : principio : slides — Princípio: índice cobridor (Index Only Scan) — quando e como aplicar"] {
  background-color: rgba(134, 222, 134, 1.0);
  text-color: rgba(0, 0, 0, 1.0);
}

state[name="IndiceParcial : principio : slides — Princípio: regras de uso e trade-offs de cada tipo de índice"] {
  background-color: rgba(134, 222, 134, 1.0);
  text-color: rgba(0, 0, 0, 1.0);
}

state[name="AplicarIndice : exercicio : hands_on — Exercício: aplicar índice correto e comparar plano antes/depois"] {
  background-color: rgba(134, 222, 134, 1.0);
  text-color: rgba(0, 0, 0, 1.0);
}

state[name="AF_M3A : avaliacao_formativa : quiz — Avaliação formativa sobre tipos de índice e condições de uso"] {
  background-color: rgba(134, 222, 134, 1.0);
  text-color: rgba(0, 0, 0, 1.0);
}

state[name="Finalidade: Escolher o índice correto para cada situação"] {
  background-color: rgba(134, 222, 134, 1.0);
  text-color: rgba(0, 0, 0, 1.0);
}

state[name="M3B — Reescrita de consulta  [Bloom: Aplicar]"] {
  background-color: rgba(255, 255, 255, 1.0);
  text-color: rgba(0, 0, 0, 1.0);
}

state[name="BoasPraticas : conceito : slides — Explanatório: EXISTS, CTE (WITH), JOIN explícito"] {
  background-color: rgba(249, 240, 107, 1.0);
  text-color: rgba(0, 0, 0, 1.0);
}

state[name="Antipadroes : conceito : slides — Explanatório: SELECT *, função em coluna WHERE, OFFSET elevado, N+1 Queries, conversão implícita de tipo"] {
  background-color: rgba(249, 240, 107, 1.0);
  text-color: rgba(0, 0, 0, 1.0);
}

state[name="Antipadroes : exemplo : codigo_sql — Exemplo: código SQL antes e depois de cada antipadrão"] {
  background-color: rgba(249, 240, 107, 1.0);
  text-color: rgba(0, 0, 0, 1.0);
}

state[name="ReescreverQuery : exercicio : hands_on — Exercício: reescrever queries reais com antipadrões identificados"] {
  background-color: rgba(249, 240, 107, 1.0);
  text-color: rgba(0, 0, 0, 1.0);
}

state[name="AF_M3B : avaliacao_formativa : quiz — Avaliação formativa sobre antipadrões SQL"] {
  background-color: rgba(255, 163, 72, 1.0);
  text-color: rgba(0, 0, 0, 1.0);
}

state[name="Finalidade: Eliminar antipadrões de SQL e reescrever queries eficientes"] {
  background-color: rgba(255, 163, 72, 1.0);
  text-color: rgba(0, 0, 0, 1.0);
}

state[name="M3C — Infraestrutura e manutenção  [Bloom: Compreender]"] {
  background-color: rgba(255, 255, 255, 1.0);
  text-color: rgba(0, 0, 0, 1.0);
}

state[name="Estatisticas : conceito : slides — Explanatório: cardinalidade, histograma, MCV (Most Common Values)"] {
  background-color: rgba(211, 211, 211, 1.0);
  text-color: rgba(0, 0, 0, 1.0);
}

state[name="VACUUM : conceito : slides — Explanatório: VACUUM remove tuplas mortas e fragmentação"] {
  background-color: rgba(211, 211, 211, 1.0);
  text-color: rgba(0, 0, 0, 1.0);
}

state[name="ANALYZE : procedimento : slides — Procedimento: ANALYZE atualiza estatísticas do planejador"] {
  background-color: rgba(211, 211, 211, 1.0);
  text-color: rgba(0, 0, 0, 1.0);
}

state[name="EstatisticasDesatualizadas : principio : slides — Princípio: impacto de estatísticas desatualizadas no plano"] {
  background-color: rgba(211, 211, 211, 1.0);
  text-color: rgba(0, 0, 0, 1.0);
}

state[name="ImpactoEstatisticas : exercicio : hands_on — Exercício: demonstrar impacto de estatísticas desatualizadas"] {
  background-color: rgba(211, 211, 211, 1.0);
  text-color: rgba(0, 0, 0, 1.0);
}

state[name="AF_M3C : avaliacao_formativa : quiz — Avaliação formativa sobre estatísticas e VACUUM"] {
  background-color: rgba(53, 102, 222, 1.0);
  text-color: rgba(255, 255, 255, 1.0);
}

state[name="Finalidade: Manter o planejador com estatísticas precisas"] {
  background-color: rgba(53, 102, 222, 1.0);
  text-color: rgba(255, 255, 255, 1.0);
}

state[name="Avaliação Final  [Bloom: Avaliar]"] {
  background-color: rgba(255, 255, 255, 1.0);
  text-color: rgba(0, 0, 0, 1.0);
}

state[name="QueriesProblematicas : avaliacao_somativa : hands_on — Avaliação somativa: 5 queries problemáticas — diagnosticar, corrigir e justificar"] {
  background-color: rgba(154, 153, 150, 1.0);
  text-color: rgba(0, 0, 0, 1.0);
}

state[name="FeedbackAutomatico : complementar : sistema — Complementar: feedback automático com explicação de cada resposta"] {
  background-color: rgba(154, 153, 150, 1.0);
  text-color: rgba(0, 0, 0, 1.0);
}

state[name="Finalidade: Avaliar a aprendizagem de todo o OA"] {
  background-color: rgba(94, 92, 100, 1.0);
  text-color: rgba(255, 255, 255, 1.0);
}
</val>
</styleSheet>
